{
  "name": "maximus-boats",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "build": "node --env-file-if-exists=.env.local scripts/build.mjs",
    "preview": "node --env-file-if-exists=.env.local scripts/dev.mjs --no-build",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "verify:media": "node scripts/verify-media.mjs",
    "check:all": "npm run check && npm test && npm run verify:media && npm run build",
    "export:preview": "node scripts/export-preview.mjs"
  },
  "license": "UNLICENSED"
}
